{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    },
    "ChildProfile": {
      "title": "ChildProfile",
      "description": "Profile of the user's child",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ageInMonths": {
          "type": "number"
        },
        "heightCm": {
          "type": "number"
        },
        "weightKg": {
          "type": "number"
        },
        "gender": {
          "type": "string",
          "enum": ["Laki-laki", "Perempuan"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "name", "ageInMonths", "heightCm", "weightKg", "gender", "updatedAt"]
    },
    "QuestionnaireResult": {
      "title": "QuestionnaireResult",
      "description": "Result of a completed questionnaire",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "ageCategory": {
          "type": "string"
        },
        "answers": {
          "type": "object"
        },
        "totalScore": {
          "type": "number"
        },
        "aiAnalysis": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "profileId", "ageCategory", "answers", "totalScore", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "User"
      },
      "description": "User profiles"
    },
    "/childProfiles/{profileId}": {
      "schema": {
        "$ref": "ChildProfile"
      },
      "description": "Child profiles linked to users"
    },
    "/questionnaireResults/{resultId}": {
      "schema": {
        "$ref": "QuestionnaireResult"
      },
      "description": "Questionnaire results for children"
    }
  }
}
